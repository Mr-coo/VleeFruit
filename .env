# Copy to .env and adjust. Compose reads this automatically.

# Backend
BACKEND_PORT=8080

# Postgres
POSTGRES_USER=vleefruit
POSTGRES_PASSWORD=vleefruit
POSTGRES_DB=vleefruit
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=fruit-images
S3_REGION=us-east-1