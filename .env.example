# Copy to .env and adjust. Compose reads this automatically.

# Backend
BACKEND_PORT=8080

# Postgres
POSTGRES_USER=vleefruit
POSTGRES_PASSWORD=vleefruit
POSTGRES_DB=vleefruit
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=fruit-images
S3_REGION=us-east-1

# AI model (in-process ONNX). Put your model at ./backend/models/model.onnx
# (mounted read-only into the container at /app/models).
MODEL_PATH=/app/models/model.onnx
MODEL_INPUT_NAME=images
MODEL_OUTPUT_NAME=output0
MODEL_INPUT_SIZE=640
# ONNX Runtime version downloaded/bundled at image build time.
ORT_VERSION=1.20.1

# Vision LLM (Google Gemini). Free tier: https://aistudio.google.com/apikey
# When GEMINI_API_KEY is unset, POST /api/v1/images returns 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
# Optional: override the instruction sent with each image.
# GEMINI_PROMPT=

# MQTT layer (runs alongside the HTTP server). Defaults to the bundled Mosquitto
# broker (service "mqtt"). Set MQTT_BROKER_URL empty to disable the layer.
MQTT_PORT=1883
MQTT_BROKER_URL=tcp://mqtt:1883
MQTT_CLIENT_ID=vleefruit-backend
# Broker credentials (required: the broker refuses anonymous clients and won't
# start without these). The backend uses MQTT_USERNAME/MQTT_PASSWORD; devices
# use the MQTT_DEVICE_* pair, which may only publish requests and read replies.
# In production these come from GitHub secrets via the deploy workflow.
MQTT_USERNAME=vleefruit-backend
MQTT_PASSWORD=change-me
MQTT_DEVICE_USERNAME=vleefruit-device
MQTT_DEVICE_PASSWORD=change-me-too
MQTT_REQUEST_TOPIC=vleefruit/request
MQTT_RESPONSE_TOPIC=vleefruit/response
# Publish raw image bytes to the image request topic; the LLM analysis is
# published on the image response topic.
MQTT_IMAGE_REQUEST_TOPIC=vleefruit/image/request
MQTT_IMAGE_RESPONSE_TOPIC=vleefruit/image/response
MQTT_QOS=0
