# Copy to .env and adjust. Compose reads this automatically.

# Backend
BACKEND_PORT=8080

# Postgres
POSTGRES_USER=vleefruit
POSTGRES_PASSWORD=vleefruit
POSTGRES_DB=vleefruit
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=fruit-images
S3_REGION=us-east-1

# MQTT / Mosquitto
MQTT_TLS_PORT=8883
MQTT_PORT=1883
# Password for the backend's privileged MQTT account. If you change this, also
# regenerate mosquitto/passwords: docker run --rm httpd:2.4-alpine \
#   htpasswd -bnBC 10 backend <password> | sed 's/\$2y\$/\$2b\$/'
MQTT_BACKEND_PASSWORD=backend-dev-secret

# Admin bearer token for the management REST API (/api/v1/*)
ADMIN_TOKEN=dev-admin-token
