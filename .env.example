# Copy to .env and adjust. Compose reads this automatically.

# Backend
BACKEND_PORT=8080

# Postgres
POSTGRES_USER=vleefruit
POSTGRES_PASSWORD=vleefruit
POSTGRES_DB=vleefruit
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=fruit-images
S3_REGION=us-east-1

# AI model (in-process ONNX). Put your model at ./backend/models/model.onnx
# (mounted read-only into the container at /app/models).
MODEL_PATH=/app/models/model.onnx
MODEL_INPUT_NAME=images
MODEL_OUTPUT_NAME=output0
MODEL_INPUT_SIZE=640
# ONNX Runtime version downloaded/bundled at image build time.
ORT_VERSION=1.20.1
