# Copy to .env and adjust. Compose reads this automatically.

# Backend
BACKEND_PORT=8080
# Deployment environment: development (text logs) or production (JSON logs).
APP_ENV=development
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Postgres
POSTGRES_USER=vleefruit
POSTGRES_PASSWORD=vleefruit
POSTGRES_DB=vleefruit
POSTGRES_PORT=5432

# Adminer (web DB UI) host port
ADMINER_PORT=8081

# Redis
REDIS_PORT=6379

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=fruit-images
S3_REGION=us-east-1

# MQTT / Mosquitto
MQTT_TLS_PORT=8883
MQTT_PORT=1883
# Password for the backend's privileged MQTT account. If you change this, also
# regenerate mosquitto/passwords: docker run --rm httpd:2.4-alpine \
#   htpasswd -bnBC 10 backend <password> | sed 's/\$2y\$/\$2b\$/'
MQTT_BACKEND_PASSWORD=backend-dev-secret

# Admin bearer token for the management REST API (/api/v1/*)
ADMIN_TOKEN=dev-admin-token

# --- Request protections ---
# Max REST request body the admin API will read, in bytes (default 1 MiB).
HTTP_MAX_BODY_BYTES=1048576
# Per-client-IP rate limit for the HTTP API: sustained requests/sec + burst.
# Set RATE_LIMIT_RPS=0 to disable.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# Max raw image payload accepted from a device over MQTT, in bytes (default 8 MiB).
MQTT_MAX_IMAGE_BYTES=8388608
